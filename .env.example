# BotFather bergan token (majburiy)
BOT_TOKEN=123456:ABC...

# Webhook rejimi: bo'sh qoldirilsa — polling (mahalliy ishlab chiqish uchun)
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8080

# Ma'lumotlar bazasi (sozlamalar va anonim statistika)
DB_PATH=alifbo.db
# Statistikadagi foydalanuvchi xeshi uchun tuz — ixtiyoriy uzun tasodifiy satr
STATS_SALT=

# /stats buyrug'iga ruxsat berilgan Telegram ID'lar, vergul bilan
ADMIN_IDS=

# Spam limiti: so'rov/daqiqa (bepul tarif)
RATE_LIMIT=30

# Tutuq belgisi (imlo qoidalari tasdiqlangach o'zgartiriladi)
# TUTUQ= (standart: ASCII apostrof ')

# Sayt: ommaviy manzil (masalan, https://imlochi.uz). Bo'sh bo'lsa, botda "Sayt" tugmasi chiqmaydi
SITE_URL=
# Polling rejimida ham saytni HOST:PORT da ishga tushirish (1/0)
WEB_ENABLED=1
# Sayt API limiti: so'rov/daqiqa, IP bo'yicha
WEB_RATE_LIMIT=60

# --- Serverga joylash (docker compose + Caddy) ---
# DNS: domenning A yozuvi server IP manziliga qaratilgan bo'lishi kerak
DOMAIN=imlochi.sifatedu.uz
# WEBHOOK_URL=https://imlochi.sifatedu.uz
# SITE_URL=https://imlochi.sifatedu.uz
# WEBHOOK_SECRET=<uzun tasodifiy satr, faqat A-Z a-z 0-9 _ ->
